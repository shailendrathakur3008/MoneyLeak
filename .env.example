FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=moneyleak-production-sec-key-7f9a12c8b4e05139
DATABASE_URL=sqlite:///moneyleak.db
SESSION_COOKIE_SECURE=False

# =============================================================================
# REAL EMAIL DELIVERY CONFIGURATION (Choose Option 1 or Option 2)
# =============================================================================

# Option 1: Resend API (Recommended for Vercel & serverless — 3,000 free emails/mo)
# Get your free API key at https://resend.com
RESEND_API_KEY=
MAIL_FROM=MoneyLeak <onboarding@resend.dev>

# Option 2: Gmail SMTP / Custom Mail Server
# For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Development / Instant Access fallback
# Set to 'true' to display the instant access OTP on screen if email is not configured
SHOW_DEV_OTP=true

# Universal Expense Sync (India Account Aggregator — Setu / Sahamati ecosystem)
# Leave blank to use verified Sandbox simulation mode; provide credentials for live API
AA_ENVIRONMENT=sandbox
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
